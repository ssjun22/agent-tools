#!/bin/bash
#
# Claude Code SessionStart hook — project-context strategy
#
# 세션 시작 시 .claude/context/index.md를 읽어 AI에게 프로젝트 컨텍스트를 주입한다.
#
# Install: .claude/settings.local.json 에 추가
# {
#   "hooks": {
#     "SessionStart": [{ "hooks": [{ "type": "command", "command": "bash .claude/hooks/load-context" }] }]
#   }
# }
#

CONTEXT_DIR=".claude/context"
INDEX_FILE="$CONTEXT_DIR/index.md"

# context/ 디렉토리가 없으면 이 전략을 사용하지 않는 프로젝트 — 조용히 skip
if [ ! -d "$CONTEXT_DIR" ]; then
    exit 0
fi

# index.md가 없으면 초기화 안내
if [ ! -f "$INDEX_FILE" ]; then
    echo ""
    echo "⚠️  .claude/context/index.md 가 없습니다."
    echo "    /project-context-init 스킬로 초기화하세요."
    echo ""
    exit 0
fi

echo ""
echo "=== 프로젝트 컨텍스트 로드 ==="
echo ""

cat << 'EOF'
🤖 AI 지시사항:

.claude/context/index.md 를 읽고 사용자에게 다음 형식으로 요약하세요:

[컨텍스트 로드됨]
프로젝트: {프로젝트명} — {목적 한 줄}
진행 중: {진행 중인 작업 한 줄}

상세 정보가 필요하면 project.md 또는 status.md 를 참조하세요.
EOF

echo ""
exit 0
