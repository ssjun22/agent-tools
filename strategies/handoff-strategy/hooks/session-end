#!/bin/bash
#
# Claude Code session-end hook for handoff strategy
#
# This hook automatically updates handoff when a session ends.
# Install: Add to .claude/settings.local.json
#
# {
#   "hooks": {
#     "sessionEnd": ".claude/hooks/session-end"
#   }
# }
#

# Configuration
HANDOFF_DIR=".claude/handoffs"
INDEX_FILE="$HANDOFF_DIR/index.md"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if handoff directory exists
if [ ! -d "$HANDOFF_DIR" ]; then
    # No handoff directory - silent skip
    exit 0
fi

echo ""
echo -e "${GREEN}=== Session End: Updating Handoff ===${NC}"
echo ""

# Prompt AI to update handoff
cat << 'EOF'
🤖 AI Agent Instructions:

Session is ending. Please update the handoff file:

1. Determine which handoff file to update (or create new one)
   - If continuing existing work: Update existing file
   - If new work: Create new file with format: {YYYY-MM-DD}-{task-name}.md

2. Update/Create handoff file with:
   - What Was Done (this session)
   - Current Status
   - Issues/Blockers (if any)
   - Next Steps
   - Decisions Made (if any)

3. Update .claude/handoffs/index.md

4. Keep content under ~2000 tokens

5. Briefly confirm to user: "Handoff updated for next session"

Template: Use assets/handoff-template.md

EOF

echo -e "${YELLOW}💡 Tip: Handoff helps the next session start faster${NC}"
echo ""
exit 0
