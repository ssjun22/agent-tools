#!/bin/bash
#
# Claude Code session-start hook for handoff strategy
#
# This hook automatically loads the latest handoff when a new session starts.
# Install: Add to .claude/settings.local.json
#
# {
#   "hooks": {
#     "sessionStart": ".claude/hooks/session-start"
#   }
# }
#

# Configuration
HANDOFF_DIR=".claude/handoffs"
INDEX_FILE="$HANDOFF_DIR/index.md"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if handoff directory exists
if [ ! -d "$HANDOFF_DIR" ]; then
    # No handoff directory - silent skip
    exit 0
fi

# Check if index.md exists
if [ ! -f "$INDEX_FILE" ]; then
    echo -e "${YELLOW}⚠️  Handoff directory exists but index.md not found${NC}"
    echo "Initialize handoff system:"
    echo "  cp agent-tools/.../assets/index-template.md $INDEX_FILE"
    exit 0
fi

echo ""
echo -e "${GREEN}=== Session Start: Loading Handoff ===${NC}"
echo ""

# Find the most recent handoff file
LATEST_HANDOFF=$(find "$HANDOFF_DIR" -name "*.md" ! -name "index.md" -type f -exec ls -t {} + | head -n 1)

if [ -z "$LATEST_HANDOFF" ]; then
    echo "No handoff files found. Starting fresh session."
    exit 0
fi

# Extract task name from filename
FILENAME=$(basename "$LATEST_HANDOFF")
echo -e "${BLUE}📄 Latest handoff: $FILENAME${NC}"
echo ""

# Prompt AI to read the handoff
cat << 'EOF'
🤖 AI Agent Instructions:

Please read and summarize the latest handoff file to restore session context:

1. Read: .claude/handoffs/index.md
2. Read: (latest handoff file identified above)
3. Provide a brief summary (3-5 lines) to the user:
   - Task name and status
   - Last completed work
   - Next steps

4. Ask the user: "Ready to continue with this task, or start something new?"

EOF

echo -e "${GREEN}Handoff loading complete.${NC}"
echo ""
exit 0
