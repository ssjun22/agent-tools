#!/bin/bash
#
# Claude Code preCompact hook for handoff strategy
#
# This hook runs before context compaction to preserve important information.
# Install: Add to .claude/settings.local.json
#
# {
#   "hooks": {
#     "preCompact": "bash .claude/hooks/pre-compact"
#   }
# }
#

# Configuration
HANDOFF_DIR=".claude/handoffs"
INDEX_FILE="$HANDOFF_DIR/index.md"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if handoff directory exists
if [ ! -d "$HANDOFF_DIR" ]; then
    # No handoff directory - silent skip
    exit 0
fi

echo ""
echo -e "${GREEN}=== Context Compaction: Updating Handoff ===${NC}"
echo ""

# Prompt AI to update handoff before context is compacted
cat << 'EOF'
🤖 AI Agent Instructions:

Context is about to be compacted. Save important information to handoff NOW:

1. Determine which handoff file to update (or create new one)
   - Continuing existing work: Update existing file
   - New work: Create new file with format: {YYYY-MM-DD}-{task-name}.md

2. Update/Create handoff with current session's work:
   - What Was Done (since last handoff update)
   - Current Status
   - Issues/Blockers
   - Next Steps
   - Decisions Made

3. Update .claude/handoffs/index.md

4. Keep content under ~2000 tokens

5. Briefly confirm: "Handoff updated before compaction"

Template: Use assets/handoff-template.md

EOF

echo -e "${YELLOW}💡 This preserves context before compaction${NC}"
echo ""
exit 0
