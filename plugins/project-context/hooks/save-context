#!/bin/bash
#
# Claude Code SessionEnd hook — project-context plugin
#
# 세션 종료 시 draft로 저장되지 않은 중요한 변경사항이 있는지 확인하고
# 누락된 것이 있다면 drafts/ 에 저장하도록 AI에게 지시한다.
#
# Install: .claude/settings.local.json 에 추가
# {
#   "hooks": {
#     "SessionEnd": "bash .claude/hooks/save-context"
#   }
# }
#

CONTEXT_DIR="docs/context"
DRAFTS_DIR="$CONTEXT_DIR/drafts"

# context/ 디렉토리가 없으면 이 플러그인을 사용하지 않는 프로젝트 — 조용히 skip
if [ ! -d "$CONTEXT_DIR" ]; then
    exit 0
fi

# 현재 pending 상태의 draft 파일 목록 수집
PENDING_DRAFTS=""
if [ -d "$DRAFTS_DIR" ]; then
    PENDING_DRAFTS=$(grep -l "status: pending" "$DRAFTS_DIR"/*.md 2>/dev/null | xargs -I{} basename {} 2>/dev/null | tr '\n' ', ' | sed 's/,$//')
fi

echo ""
echo "=== Session End: Project Context 점검 ==="
echo ""

cat << 'EOF'
🤖 AI Agent Instructions:

세션이 종료됩니다. 이번 세션에서 발생한 변경사항이 누락 없이 draft로 저장됐는지 확인하세요.

## 확인 항목

다음 중 draft로 저장되지 않은 항목이 있는지 검토하세요:

1. **작업 상태 변경**
   - 새로 시작한 작업 (status.md의 "진행 중" 추가 필요)
   - 완료된 작업 (status.md의 "완료" 이동 필요)
   - 보류/취소된 작업

2. **설계/아키텍처 결정**
   - 기술 선택, API 설계, 데이터 모델 변경
   - 기존 결정 번복이나 수정

3. **프로젝트 목적·방향 변경**
   - 범위 변경, 우선순위 재조정

## 처리 방법

- **이미 draft로 저장된 내용**: 그대로 둘 것 (중복 저장 불필요)
- **저장되지 않은 중요한 변경이 있다면**: `docs/context/drafts/YYYY-MM-DD-내용.md` 형식으로 draft 파일 생성

### Draft 파일 포맷

```markdown
---
date: YYYY-MM-DD HH:mm
targets:
  - status.md
status: pending
---

## 변경 내용

{변경될 내용을 구체적으로 작성}

## 맥락

{왜 이 변경이 필요한지 한두 문장}
```

- **저장할 내용이 없다면**: 아무것도 하지 않아도 됩니다.

EOF

if [ -n "$PENDING_DRAFTS" ]; then
    echo "📋 현재 pending draft: $PENDING_DRAFTS"
    echo "   → 위 draft들은 다음 세션에서 /project-context-manager 로 반영하세요."
    echo ""
fi

exit 0
