#!/bin/bash
#
# Claude Code SessionStart hook — handoff plugin
#
# 세션 시작 시 pending handoff 문서가 있으면 목록을 AI에게 주입한다.
#

HANDOFFS_DIR=".claude/handoffs"

if [ ! -d "$HANDOFFS_DIR" ]; then
    exit 0
fi

pending=$(grep -rl "status: pending" "$HANDOFFS_DIR" 2>/dev/null)

if [ -n "$pending" ]; then
    echo "[미완료 handoff 문서]"
    for f in $pending; do
        echo "  $(basename "$f")"
    done
    echo ""
    echo "이어서 작업하려면 해당 handoff를 언급하세요."
fi

exit 0
