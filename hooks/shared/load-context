#!/bin/bash
#
# Claude Code SessionStart hook — project-context plugin
#
# 세션 시작 시 project.md와 status.md 전체 내용을 AI에게 주입한다.
# refs/ 문서는 필요 시 AI가 직접 읽도록 경로만 안내한다.
#
# Install: .claude/settings.local.json 에 추가
# {
#   "hooks": {
#     "SessionStart": "bash .claude/hooks/load-context"
#   }
# }
#

CONTEXT_DIR="docs/context"
PROJECT_FILE="$CONTEXT_DIR/project.md"
STATUS_FILE="$CONTEXT_DIR/status.md"
REFS_DIR="$CONTEXT_DIR/refs"

# context/ 디렉토리가 없으면 이 플러그인을 사용하지 않는 프로젝트 — 조용히 skip
if [ ! -d "$CONTEXT_DIR" ]; then
    exit 0
fi

# project.md가 없으면 초기화 안내 후 종료
if [ ! -f "$PROJECT_FILE" ]; then
    echo "⚠️  docs/context/project.md 가 없습니다. /project-context-init 스킬로 초기화하세요."
    exit 0
fi

# project.md 전체 주입
echo "[프로젝트 컨텍스트 — project.md]"
cat "$PROJECT_FILE"

# status.md 전체 주입
if [ -f "$STATUS_FILE" ]; then
    echo ""
    echo "[프로젝트 컨텍스트 — status.md]"
    cat "$STATUS_FILE"
fi

# drafts/ pending 파일 주입
DRAFTS_DIR="$CONTEXT_DIR/drafts"
if [ -d "$DRAFTS_DIR" ] && [ -n "$(ls -A "$DRAFTS_DIR" 2>/dev/null)" ]; then
    PENDING_FILES=""
    for f in "$DRAFTS_DIR"/*; do
        if grep -q '^status: pending' "$f" 2>/dev/null; then
            PENDING_FILES="$PENDING_FILES $f"
        fi
    done
    if [ -n "$PENDING_FILES" ]; then
        echo ""
        echo "[미반영 draft — 확인 후 반영하세요]"
        for f in $PENDING_FILES; do
            echo "  $f"
        done
    fi
fi

# refs/ 문서 목록 안내 (내용은 필요 시 직접 읽도록)
if [ -d "$REFS_DIR" ] && [ -n "$(ls -A "$REFS_DIR" 2>/dev/null)" ]; then
    echo ""
    echo "[참조 문서 — 필요 시 직접 읽으세요]"
    for f in "$REFS_DIR"/*; do
        echo "  $f"
    done
fi

exit 0
