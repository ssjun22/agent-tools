{
  "plugins_path": "./plugins",
  "default_structure": {
    "required": ["README.md"],
    "optional": ["rules/", "skills/", "agents/"]
  },
  "templates": {
    "readme": "assets/templates/plugin-readme-template.md"
  },
  "repos": {
    "프로젝트-a": "/path/to/project-a",
    "프로젝트-b": "/path/to/project-b"
  }
}
