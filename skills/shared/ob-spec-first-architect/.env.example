# ob:spec-first-architect Configuration File
# Copy this file to .env and configure your settings

# =============================================================================
# Required: Obsidian Vault Path
# =============================================================================
# Specify the absolute path to your Obsidian vault
OBSIDIAN_VAULT_PATH=/Users/yourusername/Documents/Obsidian Vault

# =============================================================================
# Base Directory (Optional)
# =============================================================================
# Base directory within the vault where all project documentation is organized
# Default: ob-glens
BASE_DIR=ob-glens

# =============================================================================
# Specs Directory Name (Optional)
# =============================================================================
# Directory name for storing specification documents
# Default: specs
SPECS_DIR=specs

# =============================================================================
# Project Root Organization (Optional)
# =============================================================================
# Set to true when managing multiple projects in one vault
# false: Specs in {BASE_DIR}/{SPECS_DIR}/ (recommended if BASE_DIR is project-specific)
# true: Specs in {BASE_DIR}/{PROJECT_ROOT}/{SPECS_DIR}/ (for multi-project vaults)
# Default: false
USE_PROJECT_ROOT=false

# =============================================================================
# Default Project Name (Optional)
# =============================================================================
# Used when PROJECT_ROOT cannot be auto-detected
# If empty, will prompt user for project name
DEFAULT_PROJECT_NAME=

# =============================================================================
# Optional: Project Path to Obsidian Folder Mapping
# =============================================================================
# Format: /absolute/path/to/project=obsidian-folder-name
#
# If a project path is listed here, the specified folder name will be used.
# If not listed, the skill will auto-detect the folder name from:
#   1. Git repository name (from 'git remote get-url origin')
#   2. Current directory name (fallback)
#
# Examples:
# /Users/yourusername/projects/agent-tools=agent-tools
# /Users/yourusername/work/my-super-long-repo-name=my-app
# /Users/yourusername/monorepo/frontend=frontend
# /Users/yourusername/monorepo/backend=backend

# Add your project mappings below:
# /path/to/project=folder-name
